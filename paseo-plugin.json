{
  "id": "pdf-viewer",
  "name": "PDF viewer",
  "description": "View PDF files from a workspace in Paseo, one tab per document.",
  "media": [
    "assets/screenshot-desktop.png",
    "assets/screenshot-mobile.png"
  ],
  "build": [
    [
      "npm",
      "ci",
      "--omit=dev",
      "--ignore-scripts"
    ],
    [
      "node",
      "scripts/prepare.mjs"
    ]
  ],
  "requirements": {
    "paseo": ">=0.11.2 <0.13.0"
  }
}
